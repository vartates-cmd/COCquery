# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Local development. In Vercel set this to https://<your-domain>
AUTH_URL=http://localhost:3000
# Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Sheets (service account) ---
# The long id in the spreadsheet URL, between /d/ and /edit
GOOGLE_SHEET_ID=
# "client_email" from the service account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" from the same JSON, on ONE line, in double quotes, with the
# newlines written as literal \n. lib/env.ts converts them back.
GOOGLE_PRIVATE_KEY=""

# --- Bootstrap ---
# Comma-separated. These accounts are admins even if the spreadsheet is
# unreachable, so keep the list short.
BOOTSTRAP_ADMIN_EMAILS=
